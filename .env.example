# Example only. Set these in your shell; .env is not auto-loaded.
# Never commit real credentials. Default provider makes no paid calls.
Engine__Provider=Mock
# Only for explicitly selected OpenAICompatible mode:
# Engine__BaseUrl=https://your-provider.example/api/native/v1/
Engine__PromptModel=gpt-4.1-mini
Engine__ImageModel=gpt-image-1.5
Engine__ImageSize=1024x1024
Engine__MaxConcurrency=2
Engine__MaxAttempts=3
# Relative to the API content root; absolute paths are recommended.
Engine__DataDirectory=data
# Required only when Engine__Provider=OpenAI
OPENAI_API_KEY=
